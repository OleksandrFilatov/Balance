# Задайте переменные в окружении backend. Файл .env автоматически не загружается.
DB_URL=jdbc:postgresql://localhost:5432/balance_db
DB_USERNAME=balance_app
DB_PASSWORD=
SERVER_PORT=8080

# Optional local-finance profile: credentials are required, no default password.
# At least 16 characters, at most 72 UTF-8 bytes.
BALANCE_LOCAL_USERNAME=
BALANCE_LOCAL_PASSWORD=

# Automatic bookkeeping requires this opt-in AND the individual template checkbox.
BALANCE_RECURRING_AUTO_ENABLED=false
BALANCE_TIME_ZONE=Europe/Berlin
